# Copy to .env and adjust. All paths may be relative to the backend/ directory.
BTCRISK_ENVIRONMENT=development
BTCRISK_LOG_LEVEL=INFO
BTCRISK_LOG_TO_FILE=true

BTCRISK_RAW_DIR=data/raw
BTCRISK_PROCESSED_DIR=data/processed
BTCRISK_FEATURES_DIR=data/features
BTCRISK_RESULTS_DIR=data/results
BTCRISK_MODELS_DIR=models
BTCRISK_DUCKDB_PATH=data/results/analysis.duckdb
BTCRISK_SCHEMA_MAPPING_PATH=config/schema_mapping.json

# Local MaxMind GeoLite2 files (download separately; never committed)
BTCRISK_GEOLITE_CITY_DB=data/geolite/GeoLite2-City.mmdb
BTCRISK_GEOLITE_ASN_DB=data/geolite/GeoLite2-ASN.mmdb
BTCRISK_GEO_CACHE_SIZE=200000

# Explicit test-only fallback when local MMDB files are absent.
# Generate the CSV fixtures with: python -m scripts.create_synthetic_geo
BTCRISK_USE_SYNTHETIC_GEO=true
BTCRISK_SYNTHETIC_CITY_CSV=data/geolite/Synthetic-City.csv
BTCRISK_SYNTHETIC_ASN_CSV=data/geolite/Synthetic-ASN.csv

# Risk thresholds: leave unset until calibration on the real dataset
# BTCRISK_RISK_THRESHOLD_MEDIUM=
# BTCRISK_RISK_THRESHOLD_HIGH=

BTCRISK_API_HOST=127.0.0.1
BTCRISK_API_PORT=8000
BTCRISK_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
